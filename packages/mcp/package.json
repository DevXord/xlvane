{
  "name": "@xlvane/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server for XLSX files: inspect, read, write, edit, convert, compare and validate workbooks through xlvane, limited to the directories given at start.",
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/xlvane.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xlvane-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "xlvane": "0.0.0"
  }
}
