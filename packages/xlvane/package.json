{
  "name": "xlvane",
  "version": "1.0.0",
  "description": "Read, inspect and write XLSX files; input is treated as untrusted. ESM only, one runtime dependency (fflate).",
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "ooxml",
    "spreadsheetml"
  ],
  "license": "MIT",
  "homepage": "https://github.com/DevXord/xlvane#readme",
  "bugs": {
    "url": "https://github.com/DevXord/xlvane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/xlvane.git",
    "directory": "packages/xlvane"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xlvane": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "llms-full.txt"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/package-docs.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
