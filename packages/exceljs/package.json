{
  "name": "@xlvane/exceljs",
  "version": "0.0.0",
  "private": true,
  "description": "The commonly used exceljs 4.4.0 API on top of xlvane, for switching with one line in package.json.",
  "keywords": [
    "xlsx",
    "excel",
    "exceljs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/xlvane.git",
    "directory": "packages/exceljs"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "xlvane": "0.0.0"
  }
}
