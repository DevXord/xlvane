{
  "name": "@xlvane/compat",
  "version": "1.0.0",
  "description": "The commonly used exceljs 4.4.0 API on top of xlvane, for switching with one line in package.json.",
  "keywords": [
    "xlsx",
    "excel",
    "exceljs-compatible"
  ],
  "license": "MIT",
  "homepage": "https://github.com/DevXord/xlvane#readme",
  "bugs": {
    "url": "https://github.com/DevXord/xlvane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/xlvane.git",
    "directory": "packages/compat"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/es5": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/es5/index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/exceljs.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/exceljs.min.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/exceljs.bare.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/exceljs.bare.min.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#xlvane-node": {
      "node": "xlvane/node",
      "default": "./dist/no-node.js"
    },
    "#node-fs": {
      "node": "./dist/node-fs.js",
      "default": "./dist/no-node.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "xlvane": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
