{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edit.schema.json",
  "title": "xlvane edit --json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "xlvane": {
          "const": 1
        },
        "command": {
          "const": "edit"
        },
        "ok": {
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "cellsSet": {
              "type": "integer",
              "minimum": 0
            },
            "rowsAppended": {
              "type": "integer",
              "minimum": 0
            },
            "appendSheet": {
              "type": [
                "string",
                "null"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/warning"
              }
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "written": {
              "type": "boolean"
            },
            "replaced": {
              "type": "boolean"
            }
          },
          "required": [
            "input",
            "output",
            "cellsSet",
            "rowsAppended",
            "appendSheet",
            "warnings",
            "bytes",
            "written",
            "replaced"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "xlvane",
        "command",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "common.schema.json#/$defs/errorEnvelope"
    }
  ]
}
