{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp.schema.json",
  "title": "xlvane mcp --json (errors only; the server itself speaks MCP)",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "xlvane": {
          "const": 1
        },
        "command": {
          "const": "mcp"
        },
        "ok": {
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {
            "exitCode": {
              "type": "integer"
            }
          },
          "required": [
            "exitCode"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "xlvane",
        "command",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "common.schema.json#/$defs/errorEnvelope"
    }
  ]
}
