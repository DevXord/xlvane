{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inspect.schema.json",
  "title": "xlvane inspect --json (the inspect() report, docs/inspect-json.md)",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "xlvane": {
          "const": 1
        },
        "command": {
          "const": "inspect"
        },
        "ok": {
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "format": {
              "enum": [
                "xlsx",
                "xlsm",
                "xltx",
                "xltm",
                "unknown"
              ]
            },
            "conformance": {
              "enum": [
                "transitional",
                "strict"
              ]
            },
            "dateSystem": {
              "enum": [
                "1900",
                "1904"
              ]
            },
            "hasMacros": {
              "type": "boolean"
            },
            "externalLinkCount": {
              "type": "integer",
              "minimum": 0
            },
            "sheetCount": {
              "type": "integer",
              "minimum": 0
            },
            "sheets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "kind": {
                    "enum": [
                      "worksheet",
                      "chartsheet",
                      "dialogsheet",
                      "macrosheet"
                    ]
                  },
                  "state": {
                    "enum": [
                      "visible",
                      "hidden",
                      "veryHidden"
                    ]
                  },
                  "dimension": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "usedRange": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rowCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "columnCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cellCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "formulaCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mergedRanges": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "headerRow": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "row": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "confidence": {
                            "enum": [
                              "high",
                              "low"
                            ]
                          }
                        },
                        "required": [
                          "row",
                          "confidence"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "letter": {
                          "type": "string"
                        },
                        "header": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "dominantType": {
                          "$ref": "common.schema.json#/$defs/cellType"
                        },
                        "types": {
                          "type": "object",
                          "properties": {
                            "number": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "string": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "boolean": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "date": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "error": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "empty": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "number",
                            "string",
                            "boolean",
                            "date",
                            "error",
                            "empty"
                          ],
                          "additionalProperties": false
                        },
                        "samples": {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        }
                      },
                      "required": [
                        "index",
                        "letter",
                        "header",
                        "dominantType",
                        "types",
                        "samples"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "columnsTruncated": {
                    "type": "boolean"
                  },
                  "formulas": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "cell": {
                          "type": "string"
                        },
                        "formula": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "cell",
                        "formula"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "name",
                  "index",
                  "kind",
                  "state",
                  "dimension",
                  "usedRange",
                  "rowCount",
                  "columnCount",
                  "cellCount",
                  "formulaCount",
                  "mergedRanges",
                  "headerRow",
                  "columns",
                  "columnsTruncated",
                  "formulas"
                ],
                "additionalProperties": false
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/warning"
              }
            }
          },
          "required": [
            "schemaVersion",
            "format",
            "conformance",
            "dateSystem",
            "hasMacros",
            "externalLinkCount",
            "sheetCount",
            "sheets",
            "warnings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "xlvane",
        "command",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "common.schema.json#/$defs/errorEnvelope"
    }
  ]
}
